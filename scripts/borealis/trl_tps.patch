@@ -81,6 +81,37 @@ from trl import (
     get_quantization_config,
 )
 
+import time
+from transformers import TrainerCallback
+
+class TokensPerSecondCallback(TrainerCallback):
+    def __init__(self):
+        self.t0 = None
+        self.tokens0 = None
+        self.last_tps = None
+
+    def on_log(self, args, state, control, logs=None, **kwargs):
+        if logs is None:
+            return
+        tokens = logs.get("num_input_tokens_seen")
+        if tokens is None:
+            return
+
+        now = time.perf_counter()
+        if self.t0 is None:
+            self.t0, self.tokens0 = now, tokens
+            return
+
+        dt = now - self.t0
+        dtk = tokens - self.tokens0
+        if dt > 0 and dtk > 0:
+            self.last_tps = dtk / dt
+
+        if self.last_tps is not None:
+            logs["tokens_per_second"] = self.last_tps
+
+        self.t0, self.tokens0 = now, tokens
+
 
 logger = logging.get_logger(__name__)
 
